# ─────────────────────────────────────────────
#  Database
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ─────────────────────────────────────────────
#  JWT Secrets (use long random strings ≥32 chars)
# ─────────────────────────────────────────────
JWT_SECRET="replace-with-a-very-long-random-secret"
ACCESS_TOKEN_SECRET="replace-with-access-token-secret"
REFRESH_TOKEN_SECRET="replace-with-refresh-token-secret"

# ─────────────────────────────────────────────
#  Google OAuth 2.0
#  Get these from: https://console.cloud.google.com
#   → APIs & Services → Credentials → OAuth 2.0 Client IDs
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# The callback URL registered in Google Cloud Console
# Development: http://localhost:4000/api/auth/google/callback
# Production:  https://your-domain.com/api/auth/google/callback
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# Where to redirect users after OAuth (your frontend URL)
FRONTEND_URL="http://localhost:5173"

# ─────────────────────────────────────────────
#  Server
# ─────────────────────────────────────────────
NODE_ENV="development"
PORT=4000
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"
