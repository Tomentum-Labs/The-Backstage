# ─────────────────────────────────────────────
#  Database
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ─────────────────────────────────────────────
#  JWT Secrets (use long random strings ≥32 chars)
# ─────────────────────────────────────────────
ACCESS_TOKEN_SECRET="replace-with-access-token-secret"
REFRESH_TOKEN_SECRET="replace-with-refresh-token-secret"
TOKEN_HMAC_SECRET="replace-with-token-hmac-secret"
OAUTH_STATE_SECRET="replace-with-oauth-state-secret"

# ─────────────────────────────────────────────
#  Google OAuth 2.0
#  Get these from: https://console.cloud.google.com
#   → APIs & Services → Credentials → OAuth 2.0 Client IDs
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# The callback URL registered in Google Cloud Console
# Development: http://localhost:4000/api/auth/google/callback
# Production:  https://your-domain.com/api/auth/google/callback
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# Where to redirect users after OAuth (your frontend URL)
FRONTEND_URL="http://localhost:5173"

# ─────────────────────────────────────────────
#  Password reset email (Resend)
# ─────────────────────────────────────────────
# Placeholder value for local/dev. Replace with your real API key.
RESEND_API_KEY="re_placeholder"
EMAIL_FROM="The Backstage <no-reply@send.thebkstg.com>"
PASSWORD_RESET_URL="http://localhost:5173/auth/reset-password"
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_URL="http://localhost:4000/api/auth/email/verify"
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60

# ─────────────────────────────────────────────
#  Server
# ─────────────────────────────────────────────
NODE_ENV="development"
PORT=4000
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"
